################################################################################
# 🔒 CONFIGURATION SÉCURISÉE - VeilleSci
# 
# ⚠️  IMPORTANT: Ce fichier est pour le DÉVELOPPEMENT LOCAL.
# Pour la PRODUCTION, créer un .env.production sécurisé distinct.
#
# RÈGLES DE SÉCURITÉ:
# - ✅ Jamais commiter .env en version control
# - ✅ .env doit être dans .gitignore
# - ✅ En production: secrets très longs (20+ caractères)
# - ✅ Utiliser des mots de passe complexes (Min/Maj/Chiffres/Spéciaux)
# - ✅ Garder les secrets en variables d'environnement
################################################################################

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🚀 APPLICATION CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

APP_NAME="Veille Scientifique"
APP_ENV=local                   # local|production|staging
APP_KEY=base64:CHANGE_ME        # Générer avec: php artisan key:generate
APP_DEBUG=true                  # ❌ JAMAIS true en production
APP_URL=http://localhost

# Locale
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP CLI Server Workers (dev only)
# PHP_CLI_SERVER_WORKERS=4

# Encryption key length for passwords
BCRYPT_ROUNDS=12

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📊 LOGGING CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

LOG_CHANNEL=stack               # single|daily|slack|syslog|errorlog|stack
LOG_STACK=single                # Channels to include in stack
LOG_DEPRECATIONS_CHANNEL=null   # null|single|daily
LOG_LEVEL=debug                 # debug|info|notice|warning|error|critical|alert|emergency
LOG_AUDIT_DAYS=90               # Conserver les logs d'audit X jours

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🗄️  DATABASE CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

DB_CONNECTION=sqlite            # sqlite|mysql|pgsql|sqlsrv
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=veille_sci
# DB_USERNAME=veille_user
# DB_PASSWORD=STRONG_PASSWORD_20_CHARS_MIN

# Production override (comment in production)
# DB_CONNECTION=mysql
# DB_HOST=${DB_HOST}
# DB_PORT=${DB_PORT}
# DB_DATABASE=${DB_DATABASE}
# DB_USERNAME=${DB_USERNAME}
# DB_PASSWORD=${DB_PASSWORD}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔐 SESSION & COOKIE CONFIGURATION (SÉCURITÉ)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

SESSION_DRIVER=database         # file|cookie|database|memcached|redis
SESSION_LIFETIME=120            # Minutes (2 hours = 120)
SESSION_ENCRYPT=false           # true|false (true in production)
SESSION_SECURE_COOKIES=false    # true|false (HTTPS only - true in production)
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE_NAME=XSRF-TOKEN

# Rate Limiting Configuration
RATE_LIMITING_ENABLED=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📡 BROADCAST & QUEUE CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log            # pusher|ably|reverb|redis|log

FILESYSTEM_DISK=local           # local|public|s3

QUEUE_CONNECTION=database       # sync|database|beanstalkd|sqs|redis
QUEUE_FAILED_TABLE=failed_jobs

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 💾 CACHE CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

CACHE_STORE=database            # file|database|redis|memcached|dynamodb
# CACHE_PREFIX=veille_sci_

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📧 MAIL CONFIGURATION (SÉCURISÉ)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

MAIL_MAILER=log                 # log|smtp|sendmail|mailgun|postmark|resend|ses

# SMTP Configuration (use in production)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io     # Your SMTP provider
# MAIL_PORT=587
# MAIL_USERNAME=your-username
# MAIL_PASSWORD=your-password    # Use App Password if Gmail
# MAIL_ENCRYPTION=tls            # tls|ssl

MAIL_FROM_ADDRESS=noreply@veille-sci.local
MAIL_FROM_NAME="${APP_NAME}"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔐 OAUTH & EXTERNAL SERVICES (SECRETS)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# Anthropic (Claude AI) Configuration
ANTHROPIC_API_KEY=sk-ant-api-key-here

# Crossref API Configuration
CROSSREF_EMAIL=admin@localhost
CROSSREF_MAILTO=admin@localhost

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 SANCTUM & API CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173
SANCTUM_GUARD=web

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🎨 VITE & ASSETS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

VITE_API_BASE_URL=http://localhost:8000

################################################################################
# 📋 PRODUCTION CHECKLIST
################################################################################
# Before deploying to production, ensure:
#
# ✅ APP_ENV=production
# ✅ APP_DEBUG=false
# ✅ APP_KEY is set (use `php artisan key:generate`)
# ✅ DB credentials are strong (20+ chars, complex)
# ✅ SESSION_ENCRYPT=true
# ✅ SESSION_SECURE_COOKIES=true
# ✅ All API keys/secrets are unique per environment
# ✅ MAIL_MAILER is configured (not 'log')
# ✅ LOG_LEVEL=warning (not debug)
# ✅ .env is NOT in version control (.gitignore)
# ✅ .env permissions are 600 (read-write owner only)
# ✅ Backup .env before updating
# ✅ Test in staging environment first
#
# 🔒 SECURITY REMINDERS:
# - Never commit .env to git
# - Never share API keys or passwords
# - Use environment-specific .env files
# - Rotate secrets regularly
# - Monitor access logs
# - Keep Laravel and dependencies updated
#
################################################################################
